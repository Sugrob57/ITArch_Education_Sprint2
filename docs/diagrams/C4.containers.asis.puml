' Rel_Back_Neighbor(account_api, account_db, "Чтение/запись данных по аккаунтам", "sync, JDBC")
' Rel_Back(customer, email_system, "Sends e-mails to")
' Rel_Back(email_system, backend_api, "Sends e-mails using", "sync, SMTP")
' Rel_Neighbor(backend_api, banking_system, "Uses123", "sync/async, XML/HTTPS", $tags="sync/async")
' Rel(spa, backend_api, "Uses3", "async, JSON/HTTPS", $tags="async")
' Rel(mobile_app, backend_api, "Uses2", "async, JSON/HTTPS", $tags="async")

'SHOW_LEGEND()
@enduml